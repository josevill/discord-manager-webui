# Bot token from Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Disposable test guild ID (Server Settings → Widget → Server ID, or Developer Mode → Copy Server ID)
DISCORD_GUILD_ID=

# Application / Client ID (OAuth2 → Client ID) — optional, used for invite URL helpers
DISCORD_CLIENT_ID=

# Optional: only allow E2E against this guild ID (safety allowlist)
# E2E_ALLOW_GUILD_ID=
